# Providers to enable, in lookup priority order (lowercase, hyphenated IDs)
BARCODE_PROVIDERS=openfoodfacts,upcitemdb,barcodelookup

# Generic per-provider object. One block per provider ID:
#   PROVIDER_<ID>_API_KEY     (blank = unauthenticated)
#   PROVIDER_<ID>_BASE_URL    (blank = provider default)
#   PROVIDER_<ID>_TIMEOUT     (seconds, blank = 10)
#   PROVIDER_<ID>_USER_AGENT  (optional header)
PROVIDER_OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org/api/v2/product
PROVIDER_OPENFOODFACTS_USER_AGENT=product-barcode-lookup/0.1
PROVIDER_UPCITEMDB_API_KEY=
PROVIDER_BARCODELOOKUP_API_KEY=

# Persistent barcode cache (JSON-only values via diskcache.JSONDisk)
BARCODE_CACHE_DIR=
BARCODE_CACHE_TTL_SECONDS=604800
